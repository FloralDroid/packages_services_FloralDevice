package {
    default_applicable_licenses: ["packages_services_FloralDevice_license"],
}

license {
    name: "packages_services_FloralDevice_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

aidl_interface {
    name: "floral.device.display",
    // This vendor interface is versioned independently from the platform release cycle.
    owner: "floraldroid",
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: [
        "aidl/floral/device/display/*.aidl",
    ],
    imports: [
        "android.hardware.graphics.common-V2",
    ],
    stability: "vintf",
    backend: {
        java: {
            enabled: false,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: true,
        },
    },
    versions: ["1"],
}

aidl_interface {
    name: "floral.device.audio",
    // The HAL publishes PCM through this container-internal FMQ contract.
    owner: "floraldroid",
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: [
        "aidl/floral/device/audio/*.aidl",
    ],
    imports: [
        "android.hardware.common-V2",
        "android.hardware.common.fmq-V1",
    ],
    stability: "vintf",
    backend: {
        java: {
            enabled: false,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: true,
        },
    },
}

aidl_interface {
    name: "floral.device.display.topology",
    // External client transports adapt to this container-internal contract.
    owner: "floraldroid",
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: [
        "aidl/floral/device/display/topology/*.aidl",
    ],
    stability: "vintf",
    backend: {
        java: {
            enabled: false,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: true,
        },
    },
}

aidl_interface {
    name: "floral.device.simulation",
    // The host controls scenarios while HALs own sample generation and entropy.
    owner: "floraldroid",
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: [
        "aidl/floral/device/simulation/*.aidl",
    ],
    imports: [
        "android.hardware.common-V2",
        "android.hardware.common.fmq-V1",
    ],
    stability: "vintf",
    backend: {
        java: {
            enabled: false,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: true,
        },
    },
}

aidl_interface {
    name: "floral.device.power",
    // Floral power owns the model; FloralDevice only adapts FHC1 requests.
    owner: "floraldroid",
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: [
        "aidl/floral/device/power/*.aidl",
    ],
    stability: "vintf",
    backend: {
        java: {
            enabled: false,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: true,
        },
    },
}

aidl_interface {
    name: "floral.device.radio",
    // The Radio process owns cellular identity and runtime state.
    owner: "floraldroid",
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: [
        "aidl/floral/device/radio/*.aidl",
    ],
    stability: "vintf",
    backend: {
        java: {
            enabled: false,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: true,
        },
    },
}

aidl_interface {
    name: "floral.device.wifi",
    // The Wi-Fi model is shared by vendor control and modular system services.
    owner: "floraldroid",
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: [
        "aidl/floral/device/wifi/*.aidl",
    ],
    stability: "vintf",
    backend: {
        java: {
            enabled: true,
            sdk_version: "module_current",
            min_sdk_version: "30",
            apex_available: [
                "//apex_available:platform",
                "com.android.tethering",
                "com.android.wifi",
                "test_com.android.wifi",
            ],
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: true,
        },
    },
}

cc_defaults {
    name: "floral_device_common_defaults",
    cflags: [
        "-DEGL_EGLEXT_PROTOTYPES",
        "-DGL_GLEXT_PROTOTYPES",
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    cpp_std: "c++17",
    local_include_dirs: ["include"],
    static_libs: [
        "libarect",
    ],
}

cc_defaults {
    name: "floral_device_simulation_defaults",
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    cpp_std: "c++17",
    local_include_dirs: ["include"],
}

cc_library_static {
    name: "libfloral_device_profile",
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    cpp_std: "c++17",
    vendor_available: true,
    recovery_available: true,
    ramdisk_available: true,
    vendor_ramdisk_available: true,
    host_supported: true,
    bootstrap: true,
    srcs: ["profile/DeviceProfile.cpp"],
    export_include_dirs: ["include"],
}

cc_test_host {
    name: "floral_device_profile_tests_host",
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    cpp_std: "c++17",
    srcs: ["tests/DeviceProfileTest.cpp"],
    static_libs: ["libfloral_device_profile"],
}

cc_library_static {
    name: "libfloral_device_simulation_common",
    defaults: ["floral_device_simulation_defaults"],
    vendor_available: true,
    host_supported: true,
    srcs: [
        "simulation/ExternalStateRecord.cpp",
        "simulation/RandomProcess.cpp",
    ],
    export_include_dirs: ["include"],
}

