cc_binary {
    name: "floral_device_service",
    defaults: ["floral_device_common_defaults"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "service/main.cpp",
    ],
    static_libs: [
        "libaidlcommonsupport",
        "libfloral_device_audio_pcm",
        "libfloral_stream_codec",
        "libfloral_stream_audio",
        "libfloral_hal_control",
        "libfloral_device_display_ingress",
        "libfloral_device_display_service",
        "libfloral_device_simulation_common",
        "libfloral_hal_control_center",
        "libfloral_device_runtime",
        "libfloral_stream_session",
        "libfloral_stream_transport",
        "libfloral_unix_socket_server",
    ],
    shared_libs: [
        "android.hardware.common.fmq-V1-ndk_platform",
        "android.hardware.common-V2-ndk_platform",
        "android.hardware.graphics.common-V2-ndk_platform",
        "floral.device.audio-V1-ndk_platform",
        "floral.device.display-V1-ndk_platform",
        "floral.device.display.topology-V1-ndk_platform",
        "floral.device.power-V1-ndk_platform",
        "floral.device.radio-V1-ndk_platform",
        "floral.device.wifi-V1-ndk_platform",
        "floral.device.simulation-V1-ndk_platform",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libEGL",
        "libGLESv2",
        "libmediandk",
        "libnativewindow",
        "libfmq",
        "libfloral_ffmpeg_avcodec",
        "libfloral_ffmpeg_avutil",
        "libfloral_va_prebuilt",
        "libhardware",
        "liblog",
        "libopus",
        "libutils",
    ],
    init_rc: ["service/floral-device.rc"],
    vintf_fragments: ["service/floral-device.xml"],
    required: ["FloralInputService"],
}

