android_app {
    name: "FloralInputService",
    srcs: [
        "input/java/**/*.java",
    ],
    manifest: "input/AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    optimize: {
        enabled: false,
    },
}

