type floral_stream_file, file_type;

# The dedicated input application and vendor daemon share only the directory.
# operate.sock remains a core-owned socket while the other endpoints retain the
# vendor directory type, preserving the Treble socket boundary.
type floral_input_socket_file, file_type, coredomain_socket;

# init reads the optional identity profile before product properties are fixed.
allow init floral_stream_file:dir search;
allow init floral_stream_file:file r_file_perms;

allow floral_input floral_stream_file:dir { search getattr write add_name remove_name };
type_transition floral_input floral_stream_file:sock_file floral_input_socket_file "operate.sock";
allow floral_input floral_input_socket_file:sock_file { create getattr setattr unlink write };
get_prop(floral_input, vendor_floral_config_prop)
get_prop(floral_input, vendor_floral_input_security_prop)

# Guard against reintroducing broad endpoint ownership via another policy file.
neverallow { appdomain -floral_input } floral_stream_file:dir { write add_name remove_name };
neverallow { domain -floral_input -init -vendor_init } floral_input_socket_file:sock_file
    { create setattr unlink link rename write };
neverallow { appdomain -floral_input } floral_input:unix_stream_socket connectto;
