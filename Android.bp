package {
    default_applicable_licenses: ["packages_services_FloralStream_license"],
}

license {
    name: "packages_services_FloralStream_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

aidl_interface {
    name: "floral.stream.display",
    // This vendor interface is versioned independently from the platform release cycle.
    owner: "floraldroid",
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: [
        "aidl/floral/stream/display/*.aidl",
    ],
    imports: [
        "android.hardware.graphics.common-V2",
    ],
    stability: "vintf",
    backend: {
        java: {
            enabled: false,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: true,
        },
    },
    versions: ["1"],
}

cc_defaults {
    name: "floral_stream_common_defaults",
    cflags: [
        "-DEGL_EGLEXT_PROTOTYPES",
        "-DGL_GLEXT_PROTOTYPES",
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    cpp_std: "c++17",
    local_include_dirs: ["include"],
    static_libs: [
        "libarect",
    ],
}

cc_library_static {
    name: "libfloral_stream_codec",
    defaults: ["floral_stream_common_defaults"],
    vendor: true,
    srcs: [
        "codec/EglFrameCopier.cpp",
        "codec/EncoderSession.cpp",
        "codec/MediaCodecSurfaceEncoder.cpp",
    ],
    shared_libs: [
        "libbase",
        "libEGL",
        "libGLESv2",
        "libmediandk",
        "libnativewindow",
    ],
    target: {
        android_x86_64: {
            srcs: [
                "codec/FfmpegVaapiEncoderBackend.cpp",
                "codec/GrallocDmaBufExporter.cpp",
            ],
            header_libs: [
                "floral_display_gralloc_metadata_headers",
                "libdrm_headers",
                "libfloral_va_headers",
            ],
            shared_libs: [
                "libcutils",
                "libfloral_ffmpeg_avcodec",
                "libfloral_ffmpeg_avutil",
                "libfloral_va_prebuilt",
                "libhardware",
            ],
        },
    },
    export_include_dirs: ["include"],
}

cc_library_static {
    name: "libfloral_stream_transport",
    defaults: ["floral_stream_common_defaults"],
    vendor: true,
    srcs: [
        "transport/EncodedPacketAdapter.cpp",
        "transport/HostVideoSink.cpp",
        "transport/VideoPacketProtocol.cpp",
    ],
    shared_libs: [
        "libbase",
        "libmediandk",
        "libnativewindow",
    ],
    export_include_dirs: ["include"],
}

cc_library_static {
    name: "libfloral_stream_session",
    defaults: ["floral_stream_common_defaults"],
    vendor: true,
    srcs: [
        "session/VideoOutputController.cpp",
        "session/VideoStreamSession.cpp",
    ],
    static_libs: [
        "libfloral_stream_codec",
        "libfloral_stream_transport",
    ],
    shared_libs: [
        "libbase",
        "libEGL",
        "libGLESv2",
        "libmediandk",
        "libnativewindow",
    ],
    export_include_dirs: ["include"],
}

cc_library_static {
    name: "libfloral_stream_display_ingress",
    defaults: ["floral_stream_common_defaults"],
    vendor_available: true,
    srcs: [
        "display/HardwareBufferImporter.cpp",
    ],
    static_libs: [
        "libaidlcommonsupport",
    ],
    shared_libs: [
        "android.hardware.common-V2-ndk_platform",
        "android.hardware.graphics.common-V2-ndk_platform",
        "libcutils",
        "libnativewindow",
    ],
    export_include_dirs: ["include"],
}

cc_library_static {
    name: "libfloral_stream_display_service",
    defaults: ["floral_stream_common_defaults"],
    vendor_available: true,
    srcs: [
        "display/FrameConsumerService.cpp",
    ],
    static_libs: [
        "libfloral_stream_display_ingress",
    ],
    shared_libs: [
        "android.hardware.common-V2-ndk_platform",
        "android.hardware.graphics.common-V2-ndk_platform",
        "floral.stream.display-V1-ndk_platform",
        "libbase",
        "libbinder_ndk",
        "libnativewindow",
    ],
    export_include_dirs: ["include"],
}

cc_library_static {
    name: "libfloral_stream_runtime",
    defaults: ["floral_stream_common_defaults"],
    vendor: true,
    srcs: [
        "service/VideoFrameConsumerBackend.cpp",
    ],
    static_libs: [
        "libfloral_stream_session",
    ],
    shared_libs: [
        "android.hardware.common-V2-ndk_platform",
        "android.hardware.graphics.common-V2-ndk_platform",
        "floral.stream.display-V1-ndk_platform",
        "libbase",
        "libbinder_ndk",
        "libEGL",
        "libGLESv2",
        "libmediandk",
        "libnativewindow",
    ],
    export_include_dirs: ["include"],
}

cc_binary {
    name: "floral_stream_service",
    defaults: ["floral_stream_common_defaults"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "service/main.cpp",
    ],
    static_libs: [
        "libaidlcommonsupport",
        "libfloral_stream_codec",
        "libfloral_stream_display_ingress",
        "libfloral_stream_display_service",
        "libfloral_stream_runtime",
        "libfloral_stream_session",
        "libfloral_stream_transport",
    ],
    shared_libs: [
        "android.hardware.common-V2-ndk_platform",
        "android.hardware.graphics.common-V2-ndk_platform",
        "floral.stream.display-V1-ndk_platform",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libEGL",
        "libGLESv2",
        "libmediandk",
        "libnativewindow",
        "libfloral_ffmpeg_avcodec",
        "libfloral_ffmpeg_avutil",
        "libfloral_va_prebuilt",
        "libhardware",
    ],
    init_rc: ["service/floral-stream.rc"],
    vintf_fragments: ["service/floral-stream.xml"],
}

cc_test {
    name: "floral_stream_codec_tests",
    defaults: ["floral_stream_common_defaults"],
    vendor: true,
    srcs: [
        "tests/EglSurfaceRenderer.cpp",
        "tests/HostVideoSinkTest.cpp",
        "tests/MediaCodecSurfaceEncoderTest.cpp",
    ],
    static_libs: [
        "libfloral_stream_codec",
        "libfloral_stream_session",
        "libfloral_stream_transport",
    ],
    shared_libs: [
        "libbase",
        "libEGL",
        "libGLESv2",
        "libmediandk",
        "libnativewindow",
    ],
    target: {
        android_x86_64: {
            shared_libs: [
                "libcutils",
                "libfloral_ffmpeg_avcodec",
                "libfloral_ffmpeg_avutil",
                "libfloral_va_prebuilt",
                "libhardware",
            ],
        },
    },
    test_suites: ["device-tests"],
}

cc_test {
    name: "floral_stream_display_tests",
    defaults: ["floral_stream_common_defaults"],
    srcs: [
        "tests/FrameConsumerServiceTest.cpp",
        "tests/HardwareBufferImporterTest.cpp",
    ],
    static_libs: [
        "libaidlcommonsupport",
        "libfloral_stream_display_ingress",
        "libfloral_stream_display_service",
    ],
    shared_libs: [
        "android.hardware.common-V2-ndk_platform",
        "android.hardware.graphics.common-V2-ndk_platform",
        "floral.stream.display-V1-ndk_platform",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libnativewindow",
    ],
    test_suites: ["device-tests"],
}
